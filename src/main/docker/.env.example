# =============================================================================
# Bracket – docker & runtime environment
# This file is loaded by `docker compose --env-file src/main/docker/.env`
# (used automatically by every `make docker-*` target). It is listed in
# .gitignore so real secrets never end up in the repository.
# =============================================================================

# ---- Compose -----------------------------------------------------------------
COMPOSE_PROJECT_NAME=bracket

# ---- PostgreSQL --------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Schema bootstrap (consumed by src/main/docker/schema/01-schema-init.sh)
# The application will NEVER use `public` as the default schema.
APP_SCHEMA=bracket
# Optional: pre-create additional schemas, comma separated, e.g. "auth,audit"
APP_EXTRA_SCHEMAS=

# ---- Application -------------------------------------------------------------
HTTP_PORT=8080
APP_IMAGE=bracket:latest
# Which Quarkus profile the containerised jar starts with (dev | prod | default)
QUARKUS_PROFILE=prod

# ---- Datasource pool (optional overrides) -------------------------------------
DB_POOL_MIN=5
DB_POOL_MAX=20
